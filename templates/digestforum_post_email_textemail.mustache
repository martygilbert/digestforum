{{!
    @template mod_digestforum/digestforum_post_email_textemail

    Template which defines a digestforum post for sending in a single-post text email.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * coursename
    * digestforumname
    * showdiscussionname
    * discussionname
    * permalink
    * subject
    * authorfullname
    * postdate
    * message
    * attachments
    * canreply
    * replylink
    * unsubscribedigestforumlink
    * unsubscribediscussionlink
    * digestforumindexlink
    * isprivatereply

    Example context (json):
    {
        "coursename": "Example course",
        "digestforumname": "Announcements",
        "showdiscussionname": true,
        "discussionname": "Welcome",
        "permalink": "https://example.com/mod/digestforum/discuss.php?d=2#p2",
        "subject": "Welcome to the course",
        "authorfullname": "Jane Doe",
        "postdate": "Thursday, 5 November 2026, 7:00 AM",
        "message": "Welcome to the course. Please introduce yourself.",
        "attachments": "",
        "canreply": true,
        "replylink": "https://example.com/mod/digestforum/post.php?reply=2",
        "unsubscribedigestforumlink": "https://example.com/mod/digestforum/subscribe.php?id=1",
        "unsubscribediscussionlink": "https://example.com/mod/digestforum/subscribe.php?id=1&d=2",
        "digestforumindexlink": "https://example.com/mod/digestforum/index.php?id=2",
        "isprivatereply": false
    }
}}
{{{ coursename }}} -> {{# str }} digestforums, digestforum {{/ str }} -> {{{ digestforumname }}}{{# showdiscussionname }} -> {{{ discussionname }}} {{/ showdiscussionname }}
{{ permalink }}
{{{ subject }}}
{{# str }} bynameondate, digestforum, {
        "name": {{# quote }}{{{ authorfullname }}}{{/ quote }},
        "date": {{# quote}}{{ postdate }}{{/ quote }}
    } {{/ str }}
{{# isprivatereply }}
{{# str }} postisprivatereply, digestforum {{/ str }}
{{/ isprivatereply }}
---------------------------------------------------------------------
{{{ message }}}

{{{ attachments }}}
---------------------------------------------------------------------
{{# str }} postmailinfo, digestforum, {{{ coursename }}} {{/ str }}

{{# canreply }}
    {{^ isprivatereply }}
        {{# str }} postmailreply, digestforum, {{{ replylink }}} {{/ str }}
    {{/ isprivatereply }}
{{/ canreply }}
{{# unsubscribedigestforumlink }}
{{# str }} unsubscribelink, digestforum, {{{ unsubscribedigestforumlink }}} {{/ str }}
{{/ unsubscribedigestforumlink }}
{{# unsubscribediscussionlink }}
{{# str }} unsubscribediscussionlink, digestforum, {{{ unsubscribediscussionlink }}} {{/ str }}
{{/ unsubscribediscussionlink }}
{{# str }} digestmailpostlink, digestforum, {{{ digestforumindexlink }}} {{/ str }}
