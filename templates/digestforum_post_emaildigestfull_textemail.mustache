{{!
    @template mod_digestforum/digestforum_post_emaildigestfull_textemail

    Template which defines a digestforum post for sending in a single-post text email.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * authorfullname
    * postdate
    * message
    * attachments

    Example context (json):
    {
        "authorfullname": "Jane Doe",
        "postdate": "Thursday, 5 November 2026, 7:00 AM",
        "message": "Welcome to the course. Please introduce yourself.",
        "attachments": ""
    }
}}

{{# str }} bynameondate, digestforum, {
        "name": {{# quote }}{{{ authorfullname }}}{{/ quote }},
        "date": {{# quote }}{{ postdate }}{{/ quote }}
    } {{/ str }}
---------------------------------------------------------------------
{{{ message }}}
{{# attachments }}
{{{ attachments }}}
{{/ attachments }}
---------------------------------------------------------------------
